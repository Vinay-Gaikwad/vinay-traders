{
  "name": "vinay-traders",
  "private": true,
  "version": "0.0.0",
  "description": "Vinay Traders hardware and plumbing management software",
  "author": "Vinay Traders",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "client:build": "tsc -b && vite build --mode client",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "desktop:dev": "npm run client:build && electron electron/main.cjs",
    "desktop:build": "npm run client:build && electron-builder --win --publish never",
    "android:sync": "npm run client:build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run client:build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run client:build && cap sync android && cd android && gradlew.bat assembleRelease",
    "release:desktop": "npm run desktop:build",
    "release:android": "npm run android:build",
    "client:android:build": "npm run client:build && cap sync android && cd android && gradlew.bat assembleDebug",
    "test": "vitest run --config vitest.config.ts",
    "desktop:cloud:build": "tsc -b && vite build --mode cloud-desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.4",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vite-plugin": "^1.57.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.136.2"
  },
  "build": {
    "appId": "com.vinaytraders.desktop",
    "productName": "Vinay Traders",
    "copyright": "Vinay Traders",
    "directories": {
      "output": "re fin"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/vinay-traders-logo.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/vinay-traders-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vinay Traders"
    }
  }
}
